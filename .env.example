# Required: Supabase project settings (server-side and public client settings).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Set this to the exact public URL users use to access the app.
# For local Docker: http://localhost:4000
CLIENT_ORIGIN=http://localhost:4000

# Optional integrations/settings.
PORT=4000
SUPABASE_QUERY_TIMEOUT_MS=5000
GIPHY_API_KEY=
VITE_TURNSTILE_SITE_KEY=
PUBLIC_API_RATE_LIMIT_PER_MINUTE=3000
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_KEY_PREFIX=
